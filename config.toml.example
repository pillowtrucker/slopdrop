# Slopdrop Configuration
#
# This file configures slopdrop's behavior across all frontends.
# Slopdrop supports multiple frontends that can run simultaneously:
#   - IRC bot (--irc, default)
#   - CLI REPL (--cli)
#   - TUI (--tui)
#   - Web server (--web)
#
# Usage examples:
#   ./slopdrop                    # IRC bot only (default)
#   ./slopdrop --cli              # CLI REPL only
#   ./slopdrop --tui              # TUI only
#   ./slopdrop --web              # Web server only
#   ./slopdrop --irc --web        # Both IRC and Web
#   ./slopdrop --cli --tui --web  # All except IRC

# ============================================================================
# IRC FRONTEND CONFIGURATION
# ============================================================================
# Used when running with --irc (or no flags, as IRC is default)
#
# SINGLE NETWORK: Use [server] for a single IRC network (backwards compatible)
# MULTI NETWORK:  Use [[servers]] for connecting to multiple networks
#                 All networks share the same TCL state/interpreter

# --- Single network example (use this OR [[servers]], not both) ---
[server]
# Optional network name (defaults to hostname if not set)
# name = "libera"

# IRC server hostname
hostname = "irc.libera.chat"

# IRC server port (usually 6667 for plaintext, 6697 for TLS)
port = 6697

# Use TLS/SSL connection
use_tls = true

# Bot nickname
nickname = "slopdrop"

# Channels to join automatically
# The bot will respond to 'tcl' and 'tclAdmin' commands in these channels
channels = ["#bottest"]

# --- Multi-network example (uncomment and remove [server] above to use) ---
# All networks share the same TCL interpreter and state.
# Use 'triggers disable_for' to control triggers per-network/channel.
#
# [[servers]]
# name = "libera"
# hostname = "irc.libera.chat"
# port = 6697
# use_tls = true
# nickname = "slopdrop"
# channels = ["#bottest", "#mychannel"]
#
# [[servers]]
# name = "oftc"
# hostname = "irc.oftc.net"
# port = 6697
# use_tls = true
# nickname = "slopdrop"
# channels = ["#myproject"]

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Applies to all frontends

[security]
# Privileged users (admins) using hostmask patterns (IRC-style)
# Admins can:
#   - Define new procedures with 'tcl proc ...'
#   - Use tclAdmin commands (history, rollback)
#   - Execute admin-only operations via web API (is_admin: true)
#
# Hostmask pattern syntax (supports wildcards):
#   * - matches any sequence of characters
#   ? - matches a single character
#
# Examples:
#   "alice!*@*"                 - user alice from any host
#   "*!*@*.example.com"         - anyone from example.com domain
#   "bob!~user@192.168.1.*"     - bob with ident ~user from 192.168.1.x
#   "admin!~admin@203.0.113.5"  - exact hostmask match
#
# For CLI/TUI/Web frontends, admins are identified by:
#   - CLI/TUI: Local username (e.g., "alice@local")
#   - Web: Set is_admin: true in API requests (no auth yet)
privileged_users = [
    "admin!*@*"
]

# Timeout for TCL evaluation in milliseconds
# Prevents infinite loops from hanging the bot
# Default: 30000 (30 seconds)
eval_timeout_ms = 30000

# Memory limit per evaluation in megabytes (Unix only, 0 = no limit)
# Uses RLIMIT_AS which limits entire process address space.
# WARNING: Small values cause crashes. If enabling, use >= 1024 MB.
# Default: 0 (disabled)
# memory_limit_mb = 0

# Maximum recursion depth for TCL procedures (0 = no limit)
# Prevents stack overflow from deeply nested procedure calls
# Default: 1000
# max_recursion_depth = 1000

# Blacklisted users (denied from running eval commands)
# Uses same hostmask pattern syntax as privileged_users
# Examples:
#   "baduser!*@*"           - block user baduser from any host
#   "*!*@evil.example.com"  - block anyone from evil.example.com
# blacklisted_users = []

# Send commit notifications to yourself when you make changes
# Default: false (only notify other admins)
# notify_self = true

# ============================================================================
# TCL INTERPRETER CONFIGURATION
# ============================================================================
# Applies to all frontends (shared TCL state)

[tcl]
# Directory for TCL state persistence
# All TCL state is saved here and versioned with git
# Each evaluation that changes state creates a git commit
state_path = "./state"

# Maximum lines of output to show at once
# Excess output is cached and available via 'more' command
# For IRC: 'tcl more'
# For CLI: '.more'
# For TUI: F2 key
# For Web: GET /api/more
max_output_lines = 10

# Whether to include the full TCL stack trace (errorInfo) in error messages
# reported to the channel. When false (the default), only the error body is
# shown so a stray error doesn't dump a wall of text. The errorInfo variable
# is still populated as usual, so users can inspect the full trace via
# `tcl puts $errorInfo`.
# show_error_traces = false

# ---- Optional Git Remote Configuration ----

# Git repository URL for state synchronization (optional)
# If set and state_path doesn't exist, will clone from this URL on startup
# Otherwise creates a new local git repository
#
# Supported URL formats:
#   HTTPS: "https://github.com/user/bot-state.git"
#   SSH:   "git@github.com:user/bot-state.git"
#   Local: "/path/to/repo.git"
#
# Examples:
#   state_repo = "https://github.com/myuser/slopdrop-state.git"
#   state_repo = "git@github.com:myuser/slopdrop-state.git"
#   state_repo = "https://gitea.example.com/myuser/bot-state.git"
#
# Note: If using SSH URLs, you may also need to set ssh_key below
# state_repo = "https://github.com/user/bot-state.git"

# SSH private key path for git push authentication (optional)
# Required when using SSH URLs (git@github.com:user/repo.git)
# Falls back to SSH agent if not specified
#
# Examples:
#   ssh_key = "/home/user/.ssh/id_rsa"
#   ssh_key = "/home/user/.ssh/bot_deploy_key"
#
# Note: Make sure the key has write access to the repository
# ssh_key = "/home/user/.ssh/id_rsa"

# ============================================================================
# CLI FRONTEND CONFIGURATION (future)
# ============================================================================
# These settings will configure the CLI REPL when implemented

# [cli]
# Prompt string (default: "slopdrop> ")
# prompt = "tcl> "
#
# History file location (default: ~/.slopdrop_history)
# history_file = "/home/user/.slopdrop_history"
#
# Maximum history entries (default: 1000)
# history_size = 1000

# ============================================================================
# TUI FRONTEND CONFIGURATION (future)
# ============================================================================
# These settings will configure the TUI when implemented

# [tui]
# Color scheme (default: "default")
# Options: default, dark, light, solarized
# theme = "default"
#
# Refresh interval in milliseconds (default: 100)
# refresh_ms = 100

# ============================================================================
# VELES INFERENCE BRIDGE  ([veles])
# ============================================================================
# Adds ONE native TCL command:
#
#   ai <prompt> ?context?     -> the model's answer, as the command's result
#
# It asks a veles agent over A2A. Native rather than a tcl/*.tcl file
# because it holds a bearer token, and SafeTclInterp is a single
# interpreter with no boundary a secret could hide behind — in Tcl, the
# first thing the channel would do is print it, and the second would be
# to point the URL somewhere else and make the bot POST the credential
# there. See src/veles_bridge.rs.
#
# Omit the section and the command is never registered, so TCL reports
# `invalid command name "ai"` rather than erroring on every call.
#
# WHAT IT COSTS: an `ai` call spends the veles operator's model tokens,
# and any proc can make one. Hence the two budgets below. They are low on
# purpose; a proc that wants a dozen completions is a proc that wants a
# bill.
#
# WHO IT IS, over there: veles reads A2A_PEER_TOKENS="slopdrop:<token>",
# and the NAME on that line is the identity its ACL resolves — so
# [acl.roles]."a2a:slopdrop" = "user" in veles' config decides what this
# bridge may do. Unnamed peers are `user` there by default, which is the
# level this bridge is meant to have.

# [veles]
# enabled = true
# url = "http://127.0.0.1:9900"
# token_env = "VELES_A2A_TOKEN"   # or token = "..." inline
# timeout_ms = 120000
# max_per_eval = 2                # model calls one evaluation may make
# max_per_minute = 10             # …and per minute, across everybody

# ============================================================================
# WEB FRONTEND CONFIGURATION  (--web)
# ============================================================================
# The HTTP API: POST /api/eval, GET /api/more, GET /api/history,
# POST /api/rollback, GET /api/health. Omit this section entirely and
# --web serves on 127.0.0.1:8080 with no authentication, which is the
# behaviour it has always had.
#
# TWO POSTURES, and the rule between them:
#
#   no tokens  -> LOOPBACK ONLY (enforced: binding elsewhere is refused),
#                 and every caller is a NON-ADMIN. Any local process may
#                 evaluate; none of them may roll state back.
#   tokens     -> a valid `Authorization: Bearer <token>` is REQUIRED,
#                 and the token says whether its holder is an admin.
#
# Privilege belongs to the TOKEN. It used to be an `is_admin` field in
# the request body, i.e. the caller chose it — and with authentication
# off and CORS wide open, "the caller" included any page in any browser
# on this machine. There is no CORS layer any more: this is a
# server-to-server API and the bundled page is same-origin.
#
# Note that `admin` does NOT mean a second, unrestricted interpreter:
# there is one interpreter and `exec`/`open`/`socket` are gone from it
# for everybody. It means the caller-context injection is skipped,
# `rollback` becomes reachable, and the request is additionally checked
# against [security] privileged_users by hostmask.

# [web]
# bind_address = "127.0.0.1"   # anything else REQUIRES at least one token
# port = 8080
#
# [[web.tokens]]
# token = "generate-me-with-openssl-rand-hex-32"
# admin = false                 # the default: evaluate, but not roll back
# name = "veles-bridge"         # a label, for logs
#
# [[web.tokens]]
# token = "a-different-32-byte-secret"
# admin = true
# name = "operator"
